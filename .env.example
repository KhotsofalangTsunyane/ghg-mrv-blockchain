# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to GitHub.

# Get a free RPC URL from https://infura.io or https://alchemy.com
# Create a project, choose the Sepolia network, copy the HTTPS endpoint.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Export your MetaMask private key: MetaMask -> Account details -> Export private key
# Use a DEDICATED test account with only test ETH in it, never a real wallet.
METAMASK_PRIVATE_KEY=your_metamask_private_key_here